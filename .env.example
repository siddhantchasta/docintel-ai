# ── DocIntel-AI Environment Variables ──
# Copy this file to .env and fill in your values.

# Required: Google Gemini API key for classification + RAG
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: API key for authenticating requests (leave empty to disable auth)
API_KEY=

# Optional: Override default paths
# STORAGE_DIR=./storage
# CHROMA_DIR=./chroma_db
# DATABASE_URL=sqlite+aiosqlite:///./docintel.db

# Optional: Upload constraints
# MAX_FILE_SIZE_MB=20
# MAX_PAGES=50
# ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif,bmp,webp

# Optional: CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Optional: Rate limiting
# RATE_LIMIT=60/minute
